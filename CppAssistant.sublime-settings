{
    // ==================== Completion ====================
    // Master switch for smart completions. Recognizes `using namespace std;`
    // and adds the `std::` prefix when needed.
    // Reference point (LSP-clangd): a built-in cache keeps responses < 5ms.
    "enable_completions": true,
    // Completion engine:
    //   true  (default, recommended) Real clangd engine: a minimal built-in
    //         LSP client drives the clangd language server directly (ported
    //         from LSP-clangd) for compiler-grade semantic completions:
    //         function signatures, overloads, container members and local
    //         variables are all accurate. User snippets sort first, and the
    //         other results respect the active C++ standard. When clangd is
    //         not found it falls back to the built-in database, so it works
    //         with zero configuration.
    //   false Built-in database mode: a pure-Python static fallback.
    //         User snippets sort first; C++14-and-older entries rank ahead
    //         of the C++17/20/23 ones (tuned for CSP-S / NOIP).
    // Takes effect immediately (the engine restarts automatically).
    "enable_clangd_engine": true,
    // Path to the clangd executable; when empty it is looked up on PATH
    // (common names such as clangd, clangd-18 ... clangd-21 are all tried).
    // On Windows the MSYS2 clangd is recommended
    // (pacman -S mingw-w64-x86_64-clang).
    "clangd_binary": "",
    // Extra command-line arguments passed to clangd, e.g. ["--log=verbose"]
    "clangd_args": [],
    // Maximum time (ms) to wait synchronously for clangd completion results.
    // On the hot path clangd usually returns in 5~30ms; on timeout the
    // built-in database results show first and clangd replaces them once
    // they arrive (matching LSP behaviour).
    // 0 (default) never blocks the editor: the first popup shows built-in
    // database results and clangd results replace them a moment later.
    // Raise it (e.g. 30) to wait for clangd inside the first popup, at the
    // cost of a small per-keystroke delay. Note that this wait happens on
    // the UI thread, so the typing feel degrades as the value grows.
    "clangd_completion_wait_ms": 0,
    // Extra clangd fallbackFlags: compile flags used when there is no
    // compile_commands.json, appended after -std=,
    // e.g. ["-I", "D:/libs/include"]
    "clangd_extra_fallback_flags": [],
    // clangd working directory (acts as the project root); when empty the
    // current file's directory is used.
    "clangd_working_dir": "",
    // Completion mode:
    //   true  (default) LSP-clangd style: every completion that starts with
    //         the current prefix and belongs to the current scope
    //         (container/algorithm/global) pops up immediately; substring
    //         and subsequence fuzzy matching is also allowed as a fallback
    //         in the relaxed mode, so it feels closest to clangd.
    //   false Strict-prefix basic mode: keeps only strict prefix matches
    //         (case-insensitive) and filters out all substring/subsequence
    //         fuzzy results - the simplest and most predictable.
    // Takes effect immediately (the completion cache is invalidated).
    "enable_clangd_style_completion": true,
    // Smart header insertion (clangd header-insertion plus universal-header
    // detection): when a completion is accepted the matching #include <X> is
    // added automatically - e.g. after completing `vector` the line
    // #include <vector> is inserted.
    //   - if the file already has #include <bits/stdc++.h> (the universal
    //     header), nothing is inserted again;
    //   - if that header is already present, it is skipped;
    //   - otherwise it is inserted after the last #include line.
    "auto_insert_includes": true,
    // Hover docs: show clangd's type/documentation popup when the mouse
    // hovers over a symbol.
    "enable_hover": true,
    // Signature help: show overload signatures while the caret is inside a
    // function-call parenthesis (matches LSP-clangd signature help).
    "enable_signature_help": true,

    // ==================== Linting ====================
    // Master switch for live syntax checking.
    // Reference points (LSP-clangd): basic checks < 10ms, compiler checks
    // (with PCH enabled) < 300ms.
    "enable_linting": true,
    // Diagnostic engine (lint_engine):
    //   "compiler" (default) call g++/clang++ in the background for a full
    //                      check (existing behaviour).
    //   "clangd"           LSP-style review: use the live diagnostics that
    //                      clangd pushes directly (matching LSP-clangd);
    //                      no compiler process is started, and messages are
    //                      still localized through the plugin's translation
    //                      table. Requires enable_clangd_engine; while
    //                      clangd is not ready only the instant basic check
    //                      results are shown.
    "lint_engine": "compiler",
    // Instant basic check: pure-Python, millisecond detection of bracket
    // balance, full-width punctuation and unclosed strings/comments -
    // reported while typing, with no need to wait for the compiler.
    "instant_basic_check": true,
    // Seconds of idle typing before the full compiler check starts (default
    // 0.1s; near-instant when deleting or fixing error lines; the compiler
    // check itself caches results to speed up repeat runs).
    "lint_debounce": 0.1,
    // Timeout (seconds) for a single compiler check; on timeout existing
    // markers are not cleared.
    "lint_timeout": 12,
    // Precompiled-header speedup: before the first check, build a cache of
    // bits/stdc++.h in the background; afterwards checks that include that
    // header run about 4~5x faster (about 1.2s -> 0.33s).
    // For performance the PCH is mounted directly via -include, so no
    // temporary .cpp file is created.
    "enable_pch": true,
    // Show inline error phantoms below the error line.
    "show_phantoms": true,
    // Diagnostic display language:
    //   "en"   English only (default)
    //   "zh"   Chinese only
    //   "both" English with Chinese appended
    // Takes effect immediately (changing the setting clears the diagnostic
    // result cache).
    "display_language": "en",
    // C++ standard (used both for the -std= flag in syntax checking and for
    // clangd's fallbackFlags). The CSP-S / NOIP contest series uses C++14,
    // so the default is c++14; raise it for C++17/20/23 feature completions
    // and checks.
    "cxx_standard": "c++14",
    // Compiler executable path; when empty, g++ and clang++ are looked up
    // automatically on PATH.
    "compiler_path": "",
    // Extra arguments passed to the compiler, e.g. ["-I", "D:/libs/include"]
    "compiler_extra_args": [],
    // Extra header search directories (also used for F12 cross-file
    // go-to-definition).
    "include_paths": [],

    // ==================== Formatting (jiangly style) ====================
    // Indent width (used by the fallback formatter; clang-format is
    // controlled by clang_format_style).
    "indent_width": 4,
    // Format the whole document on save.
    "format_on_save": false,
    // clang-format path; when empty it is looked up on PATH. If it is not
    // found, the built-in fallback formatter is used.
    "clang_format_path": "",
    // jiangly-style clang-format config: 4-space indent, K&R braces, and no
    // wrapping of long lines.
    "clang_format_style": "{ BasedOnStyle: Google, IndentWidth: 4, ColumnLimit: 100, AccessModifierOffset: -4, DerivePointerAlignment: false, PointerAlignment: Left, AllowShortIfStatementsOnASingleLine: false, AllowShortLoopsOnASingleLine: false, AllowShortCaseLabelsOnASingleLine: false, AllowShortFunctionsOnASingleLine: Inline, SortIncludes: Never, FixNamespaceComments: false, AlignConsecutiveAssignments: false, AlignConsecutiveDeclarations: false, AlignTrailingComments: false, InsertBraces: false }"
}
