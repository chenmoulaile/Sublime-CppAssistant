    <content><![CDATA[long long ext_gcd(long long a, long long b, long long &x, long long &y) {
    if (!b) { x = 1, y = 0; return a; }
    long long x1, y1;
    long long g = ext_gcd(b, a % b, x1, y1);
    x = y1, y = x1 - a / b * y1;
    return g;
}
long long mod_inv(long long a, long long m) {
    long long x = 0, y = 0;
    long long g = ext_gcd((a % m + m) % m, m, x, y);
    if (g != 1) return -1;
    return (x % m + m) % m;
}
pair<long long,long long> crt(const vector<long long> &a,
                             const vector<long long> &m) {
    long long r = 0, M = 1;
    for (int i = 0; i < (int)a.size(); ++i) {
        long long mi = m[i], ai = a[i] % mi;
        long long g = __gcd(M, mi);
        if ((ai - r) % g) return {-1, -1};
        long long p = M / g, q = mi / g;
        long long inv = mod_inv(p % q, q);
        if (inv < 0) return {-1, -1};
        long long t = ((ai - r) / g % q + q) % q * inv % q;
        r += t * M;
        M *= q;
        r = (r % M + M) % M;
    }
    return {r, M};
}
