    <content><![CDATA[struct Circle {
    Point c;
    double r = 0;
    Circle() {}
    Circle(Point c_, double r_) : c(c_), r(r_) {}
    double area() const { return PI * r * r; }
    bool contains(const Point &p) const { return (p - c).len() <= r + eps; }
};
