[
	{
		"caption": "首选项",
		"mnemonic": "n",
		"id": "preferences",
		"children":
		[
			{
				"caption": "Package Settings",
				"mnemonic": "P",
				"id": "package-settings",
				"children":
				[
					{
						"caption": "CppAssistant",
						"id": "cppassistant-settings",
						"children":
						[
							{
								"caption": "Settings – Default",
								"command": "open_file",
								"args": {
									"file": "${packages}/CppAssistant/CppAssistant.sublime-settings"
								}
							},
							{
								"caption": "Settings – User",
								"command": "edit_settings",
								"args": {
									"base_file": "${packages}/CppAssistant/CppAssistant.sublime-settings",
									"default": "{\n\t$0\n}\n"
								}
							},
							{ "caption": "-" },
							{
								"caption": "诊断显示语言 (display_language)",
								"id": "cppassistant-language",
								"children":
								[
									{
										"caption": "中文 (zh) - 仅显示中文",
										"command": "ca_set_display_language",
										"args": { "lang": "zh" },
										"checkbox": true
									},
									{
										"caption": "English (en) - 仅显示英文原文",
										"command": "ca_set_display_language",
										"args": { "lang": "en" },
										"checkbox": true
									},
									{
										"caption": "中英双语 (both) - 英文在前中文在后",
										"command": "ca_set_display_language",
										"args": { "lang": "both" },
										"checkbox": true
									}
								]
							},
							{ "caption": "-" },
							{
								"caption": "补全模式 (enable_clangd_style_completion)",
								"id": "cppassistant-completion-mode",
								"children":
								[
									{
										"caption": "LSP-clangd 风格 (clangd) - 所有以当前前缀开头的补全立即弹出，并允许子串/子序列模糊匹配",
										"command": "ca_set_completion_mode",
										"args": { "mode": "clangd" },
										"checkbox": true
									},
									{
										"caption": "严格前缀基础模式 (basic) - 仅保留严格前缀匹配，过滤子串/子序列模糊结果",
										"command": "ca_set_completion_mode",
										"args": { "mode": "basic" },
										"checkbox": true
									}
								]
							},
							{ "caption": "-" },
							{
								"caption": "Key Bindings – Default",
								"command": "open_file",
								"args": {
									"file": "${packages}/CppAssistant/Example.sublime-keymap"
								}
							},
							{
								"caption": "Key Bindings – User",
								"command": "edit_settings",
								"args": {
									"base_file": "${packages}/CppAssistant/Example.sublime-keymap",
									"user_file": "${packages}/User/Default (${platform}).sublime-keymap",
									"default": "[\n\t$0\n]\n"
								}
							},
							{ "caption": "-" },
							{
								"caption": "命令面板（Commands）",
								"command": "open_file",
								"args": {
									"file": "${packages}/CppAssistant/CppAssistant.sublime-commands"
								}
							},
							{
								"caption": "README（使用说明）",
								"command": "open_file",
								"args": {
									"file": "${packages}/CppAssistant/README.md"
								}
							}
						]
					}
				]
			}
		]
	}
]
