[
	{
		"caption": "Preferences",
		"mnemonic": "n",
		"id": "preferences",
		"children":
		[
			{
				"caption": "Package Settings",
				"mnemonic": "P",
				"id": "package-settings",
				"children":
				[
					{
						"caption": "CppAssistant",
						"id": "cppassistant-settings",
						"children":
						[
							{
								"caption": "Settings",
								"command": "edit_settings",
								"args": {
									"base_file": "${packages}/CppAssistant/CppAssistant.sublime-settings",
									"default": "{\n\t$0\n}\n"
								}
							},
							{ "caption": "-" },
							{
								"caption": "Diagnostic language",
								"id": "cppassistant-language",
								"children":
								[
									{
										"caption": "Chinese",
										"command": "ca_set_display_language",
										"args": { "lang": "zh" },
										"checkbox": true
									},
									{
										"caption": "English",
										"command": "ca_set_display_language",
										"args": { "lang": "en" },
										"checkbox": true
									},
									{
										"caption": "English + Chinese",
										"command": "ca_set_display_language",
										"args": { "lang": "both" },
										"checkbox": true
									}
								]
							},
							{ "caption": "-" },
							{
								"caption": "Completion engine",
								"id": "cppassistant-completion-engine",
								"children":
								[
									{
										"caption": "clangd engine (semantic completions)",
										"command": "ca_set_completion_engine",
										"args": { "engine": "clangd" },
										"checkbox": true
									},
									{
										"caption": "Built-in database (no clangd needed)",
										"command": "ca_set_completion_engine",
										"args": { "engine": "builtin" },
										"checkbox": true
									}
								]
							},
							{ "caption": "-" },
							{
								"caption": "Completion mode",
								"id": "cppassistant-completion-mode",
								"children":
								[
									{
										"caption": "LSP-clangd style (fuzzy matching)",
										"command": "ca_set_completion_mode",
										"args": { "mode": "clangd" },
										"checkbox": true
									},
									{
										"caption": "Strict prefix (basic)",
										"command": "ca_set_completion_mode",
										"args": { "mode": "basic" },
										"checkbox": true
									}
								]
							},
							{ "caption": "-" },
							{
								"caption": "Show inline error phantoms",
								"command": "ca_toggle_phantoms",
								"checkbox": true
							},
							{
								"caption": "Completion engine status",
								"command": "ca_show_engine_status"
							},
							{ "caption": "-" },
							{
								"caption": "Diagnostic engine",
								"id": "cppassistant-lint-engine",
								"children":
								[
									{
										"caption": "clangd diagnostics (LSP-style)",
										"command": "ca_set_lint_engine",
										"args": { "engine": "clangd" },
										"checkbox": true
									},
									{
										"caption": "Compiler check (g++/clang++)",
										"command": "ca_set_lint_engine",
										"args": { "engine": "compiler" },
										"checkbox": true
									}
								]
							},
							{ "caption": "-" },
							{
								"caption": "Key Bindings – User",
								"command": "edit_settings",
								"args": {
									"base_file": "${packages}/CppAssistant/Example.sublime-keymap",
									"user_file": "${packages}/User/Default (${platform}).sublime-keymap",
									"default": "[\n\t$0\n]\n"
								}
							}
						]
					}
				]
			}
		]
	},
	{
		"caption": "CppAssistant",
		"mnemonic": "C",
		"children":
		[
			{ "caption": "Code Actions", "command": "ca_code_actions" },
			{ "caption": "Rename Symbol", "command": "ca_rename" },
			{ "caption": "Find References", "command": "ca_find_references" },
			{ "caption": "-" },
			{ "caption": "Format Selection", "command": "ca_format_selection" },
			{ "caption": "Format Document", "command": "ca_format_document" },
			{ "caption": "Go to Definition", "command": "ca_goto_definition" },
			{ "caption": "Show Diagnostics", "command": "ca_show_diagnostics" },
			{ "caption": "-" },
			{
				"caption": "Settings",
				"command": "edit_settings",
				"args": {
					"base_file": "${packages}/CppAssistant/CppAssistant.sublime-settings",
					"default": "{\n\t$0\n}\n"
				}
			},
			{
				"caption": "Key Bindings",
				"command": "edit_settings",
				"args": {
					"base_file": "${packages}/CppAssistant/Example.sublime-keymap",
					"user_file": "${packages}/User/Default (${platform}).sublime-keymap",
					"default": "[\n\t$0\n]\n"
				}
			}
		]
	}
]
