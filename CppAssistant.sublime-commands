[
	{ "caption": "CppAssistant: 按 jiangly 码风格式化文档", "command": "ca_format_document" },
	{ "caption": "CppAssistant: 跳转到定义", "command": "ca_goto_definition" },
	{ "caption": "CppAssistant: 显示语法诊断面板", "command": "ca_show_diagnostics" },
	{ "caption": "CppAssistant: 切换诊断语言为中文 (zh)", "command": "ca_set_display_language", "args": { "lang": "zh" } },
	{ "caption": "CppAssistant: 切换诊断语言为英文 (en)", "command": "ca_set_display_language", "args": { "lang": "en" } },
	{ "caption": "CppAssistant: 切换诊断语言为中英双语 (both)", "command": "ca_set_display_language", "args": { "lang": "both" } },
	{ "caption": "CppAssistant: 切换补全模式为 LSP-clangd 风格 (clangd)", "command": "ca_set_completion_mode", "args": { "mode": "clangd" } },
	{ "caption": "CppAssistant: 切换补全模式为严格前缀基础模式 (basic)", "command": "ca_set_completion_mode", "args": { "mode": "basic" } },
	{ "caption": "CppAssistant: 切换补全引擎为真实 clangd (clangd)", "command": "ca_set_completion_engine", "args": { "engine": "clangd" } },
	{ "caption": "CppAssistant: 切换补全引擎为内置数据库 (builtin)", "command": "ca_set_completion_engine", "args": { "engine": "builtin" } },
	{ "caption": "CppAssistant: 补全引擎诊断（clangd 是否接管）", "command": "ca_show_engine_status" },
	{ "caption": "CppAssistant: 显示/隐藏错误幽灵提示条", "command": "ca_toggle_phantoms" },
	{ "caption": "Preferences: CppAssistant Settings", "command": "edit_settings",
	  "args": {
		"base_file": "${packages}/CppAssistant/CppAssistant.sublime-settings",
		"default": "{\n\t$0\n}\n"
	  }
	},
	{ "caption": "Preferences: CppAssistant Key Bindings", "command": "edit_settings",
	  "args": {
		"base_file": "${packages}/CppAssistant/Example.sublime-keymap",
		"user_file": "${packages}/User/Default (${platform}).sublime-keymap",
		"default": "[\n\t$0\n]\n"
	  }
	}
]
